[Unit]
# The OnFailure= handler: mails root the journal of whichever unit failed.
# Instantiated as windspeed-mail@<failed-unit>.service, because OnFailure=
# passes the failing unit's full name (including its .service suffix) as %i.
#
# This is what replaces cron's MAILTO. Cron mailed on ANY output from a job,
# which is why a single dead station produced hundreds of messages a day; here
# only a unit that actually EXITS NON-ZERO mails, and windspeed-stale.service is
# the only unit that ever does.
#
# Delivery is the local exim that ansible's common_mta role installs and
# configures on this host, with root aliased to a real mailbox -- the same path
# every other alert in the estate uses (roles/pg_backup, roles/app_buzz). No MTA
# means this silently goes nowhere, which is why btlg.yml carries common_mta.
Description=Mail root the journal of failed unit %i
Documentation=https://github.com/jodok/windspeed

[Service]
Type=oneshot
# root: reads the journal and hands the message to sendmail.
User=root
#
# %i is the failed unit and %H the hostname, both substituted by systemd before
# the shell sees them. Using %H rather than $(hostname) on purpose: systemd
# expands $VAR in Exec lines but not command substitution, so a $(...) here
# would either reach sendmail literally or be rejected outright.
ExecStart=/bin/sh -c '{ \
  printf "To: root\\n"; \
  printf "Subject: [windspeed] %i failed on %H\\n"; \
  printf "Content-Type: text/plain; charset=utf-8\\n\\n"; \
  systemctl status --full --no-pager --lines=0 "%i" 2>&1; \
  printf "\\n--- last 100 journal lines ---\\n\\n"; \
  journalctl --no-pager --lines=100 --unit="%i" 2>&1; \
  } | /usr/sbin/sendmail -t -oi'

# Same belt-and-braces as the estate's other mailers: if sendmail is missing the
# alert is lost, so make that a visible unit failure rather than a silent no-op.
ExecStartPre=/usr/bin/test -x /usr/sbin/sendmail
TimeoutStartSec=60
